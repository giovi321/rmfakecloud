# env variables
JWT_SECRET_KEY=tbd
DATADIR=/var/rmfakecloud/
#RM_SMTP_USER=
#RM_SMTP_ADDRESS=

# OIDC login for the web UI. All four are required to enable it, and
# RM_HTTPS_COOKIE must be true. The tablet keeps using the enrolment code.
#OIDC_PROVIDER_URL=https://sso.example.com
#OIDC_CLIENT_ID=rmfakecloud
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URL=https://rm.example.com/ui/api/oidc/callback
#RM_HTTPS_COOKIE=true
# Optional, values shown are the defaults:
#OIDC_DISABLE_LOCAL_LOGIN=false
#OIDC_USERID_CLAIM=preferred_username
#OIDC_ALLOW_UNVERIFIED_EMAIL=false
#OIDC_EXTRA_SCOPES=
#OIDC_DISPLAY_NAME=Login with OIDC
# Optional, no default; both halves are needed for admin to follow a claim:
#OIDC_ADMIN_CLAIM=
#OIDC_ADMIN_CLAIM_VALUE=
